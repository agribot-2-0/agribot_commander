<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Fallback>
                <Sequence name="manual control squence">
                    <Condition ID="CheckStartConditions" action_to_be_started="autonomous_driving" name="check conditions for auto drive"/>
                    <Action ID="SwitchControlArbiters" control_source="navigation" name="change arbiter source to nav"/>
                    <Action ID="Handle" action_to_handle="autonomous_driving" name="handle auto drive"/>
                </Sequence>
                <Sequence name="auto drive squence">
                    <Condition ID="CheckStartConditions" action_to_be_started="manual_control" name="check conditions for manual control"/>
                    <Action ID="SwitchControlArbiters" control_source="manual" name="switch source to manual"/>
                    <Action ID="Handle" action_to_handle="manual_control" name="handle manual control"/>
                </Sequence>
            </Fallback>
            <Action ID="SwitchControlArbiters" control_source="none" name="switch source to none"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Condition ID="CheckStartConditions">
            <input_port name="action_to_be_started"/>
        </Condition>
        <Action ID="Handle">
            <input_port name="action_to_handle"/>
        </Action>
        <Action ID="SwitchControlArbiters">
            <input_port name="control_source"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>

