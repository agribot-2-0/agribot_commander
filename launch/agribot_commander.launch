<launch>
  <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/robot.yaml" />
  <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/firebase.yaml" />
  <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/map/config.yaml" />

  <group if="$(env AGRIBOT_TASK_SUPERVISOR)">
    <node name="agribot_task_supervisor_node" pkg="agribot_commander" type="agribot_task_supervisor_node.py" output="screen"/>
  </group>
  <node pkg="agribot_commander" type="agribot_behavior_node" name="agribot_behavior_node"/>
</launch>
