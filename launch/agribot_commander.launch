<launch>
  <arg name="rsn" default="ADI75R1" />

  <node name="agribot_commander_state_machine" pkg="agribot_commander" type="AgribotStateMachine.py" output="screen" />
  <node name="agribot_task_supervisor_node" pkg="agribot_commander" type="agribot_task_supervisor_node.py" output="screen" args="$(arg rsn)"/>
  <node name="navsatfix_to_local_node" pkg="agribot_commander" type="navsatfix_to_local_node" />
  <node name="move_base_monitor_node" pkg="agribot_commander" type="move_base_monitor_node" output="screen" />
</launch>
