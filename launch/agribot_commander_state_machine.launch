<launch>
    <node name="agribot_commander_state_machine" pkg="agribot_commander" type="AgribotStateMachine.py" output="screen"></node>
    <!-- <node name="path_points_stuffer_node" pkg="agribot_commander" type="path_points_stuffer_node.py" output="screen" ></node> -->
    <node name="hal_mobile_app_commands_node" pkg="agribot_commander" type="hal_mobile_app_commands_node"></node>
    <!-- Debug only for the testing phsae without localisation -->
    <node pkg="tf" type="static_transform_publisher" name="map_odom_broadcaster" args="0 0 0 0 0 0 1 map odom 100"></node>
    <node pkg="tf" type="static_transform_publisher" name="utm_map_broadcaster" args="0 0 0 0 0 0 1 utm map 100"></node>
    <!-- Debug only for the testing phsae without localisation -->
    <node name="navsatfix_to_local_node" pkg="agribot_commander" type="navsatfix_to_local_node"></node>
</launch>